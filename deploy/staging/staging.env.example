CODESTRA_SOCIAL_HOST=staging-social.codestra.co
CODESTRA_SOCIAL_ACME_EMAIL=appolon1908@gmail.com

# Exact registry digests only; tags and placeholders fail preflight.
CODESTRA_SOCIAL_IMAGE=ghcr.io/appolon1908-hue/social.codestra.co@sha256:REPLACE
CODESTRA_CADDY_IMAGE=caddy@sha256:REPLACE
CODESTRA_POSTGRES_IMAGE=postgres@sha256:REPLACE
CODESTRA_REDIS_IMAGE=redis@sha256:REPLACE
CODESTRA_PROMETHEUS_IMAGE=prom/prometheus@sha256:REPLACE
CODESTRA_GRAFANA_IMAGE=grafana/grafana@sha256:REPLACE
CODESTRA_SOCIAL_SOURCE_SHA=REPLACE_WITH_40_HEX_SHA

CODESTRA_SOCIAL_SECRET_DIR=/etc/codestra-social/staging/secrets
CODESTRA_SOCIAL_EVIDENCE_DIR=/var/lib/codestra-social/staging/evidence
DATABASE_NAME=codestra_social
DATABASE_USER=codestra_social
TRUSTED_PROXY_IPS=172.31.0.2
